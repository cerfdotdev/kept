# Database (values must match between DATABASE_URL and POSTGRES_*)
POSTGRES_USER=kept
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=kept
DATABASE_URL=postgresql://kept:change-me-strong@db:5432/kept

# App
NEXT_PUBLIC_APP_URL=https://kept.dok.cerf.codes
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true
EMAIL_PROVIDER=console
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://kept.dok.cerf.codes
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=base64-32-byte-key

# Optional: AI classification (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: email delivery
RESEND_API_KEY=
RESEND_FROM=Kept by Ledgerfolk <hello@kept.dok.cerf.codes>

# Optional: payments (demo mode simulates when absent)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Storage (container paths; volume-mounted)
UPLOAD_DIR=/uploads
ESCROW_DIR=/escrow
