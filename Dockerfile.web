# syntax=docker/dockerfile:1

# ---- base deps ----
FROM node:24-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS deps
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && pnpm config set store-dir /pnpm/store
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

# ---- builder ----
FROM node:24-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS builder
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && pnpm config set store-dir /pnpm/store
WORKDIR /app
COPY --from=deps /app ./
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_DEMO_MODE
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE
RUN pnpm --filter web build

# ---- runner ----
FROM node:24-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS runner
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
RUN useradd -r -u 1001 kept && mkdir -p /tmp /app/apps/web/.next/cache && chown -R kept:kept /app
COPY --from=builder --chown=kept:kept /app/apps/web/.next/standalone ./
COPY --from=builder --chown=kept:kept /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=kept:kept /app/apps/web/public ./apps/web/public
USER 1001
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
