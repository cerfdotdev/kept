{
  "name": "kept",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kept/db generate",
    "db:migrate": "pnpm --filter @kept/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
